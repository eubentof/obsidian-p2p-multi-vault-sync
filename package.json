{
  "name": "obsync-plugin",
  "version": "1.0.8",
  "description": "Obsync — free P2P sync for Obsidian",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "obsidian",
    "sync",
    "p2p",
    "offline-first"
  ],
  "license": "MIT OR Apache-2.0",
  "dependencies": {
    "@noble/ciphers": "^1.0.0",
    "@noble/curves": "^1.6.0",
    "@noble/hashes": "^1.5.0",
    "qrcode-generator": "^2.0.4"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/qrcode-generator": "^0.0.16",
    "esbuild": "^0.28.1",
    "obsidian": "^1.5.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.10"
  }
}
